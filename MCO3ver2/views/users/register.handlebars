<form action="/users/register" method="POST">
 <h1 class="dispaly-6 fw-bold text-center my-4">Register User</h1>
  <div class="form-floating mb-3">
    <input id="username" name="username" class="form-control" required value="{{user.username}}">
    <label>Username</label>
    {{#if errors.username}}
        <div class="text-danger">{{errors.username}}</div>
    {{/if}}
  </div>

  <div class="form-floating mb-3">
    <input id="password" name="password" class="form-control" required>
    <label>Password</label>
    {{#if errors.password}}
        <div class="text-danger">{{errors.password}}</div>
    {{/if}}
  </div>

  <div class="row mb-3">
    <div class="col">
      <div class="form-floating mb-3">
        <input id="email" type="email" name="email" class="form-control" required value="{{user.email}}">
        <label>Email</label>
        {{#if errors.email}}
            <div class="text-danger">{{errors.email}}</div>
        {{/if}}
      </div>
    </div>

  <div class="row mb-3">
    <div class="col">
      <div class="form-floating mb-3">
        Have an account already? <a href="/users/login" class="btn btn-sm btn-secondary">Login</a>
        </div>
      </div>
    </div>
  <div class="float-end">
        <button type="submit" class="btn btn-success">Register</button>
      </div>

</form>
