<h1>Edit Passenger</h1>
  <form id="reservationForm" action="/client/editPassenger/{{passenger._id}}" method="POST">
    <table id="userInfoTable">
      <tr>
        <td colspan="2"><h5>User Information</h5></td>
      </tr>
      <tr>
        <td><div class="input-group mb-3">
          <span class="input-group-text">Full Name:</span>
           <input id="fullName" name="fullName" type="text" value="{{passenger.fullName}}" class="form-control form-control-sm">                       
                        </div></td>   
                        <td><div class="input-group mb-3">
                            <span class="input-group-text">Email Address:</span>
                            <input id="email" name="email" type="email" value="{{passenger.email}}" class="form-control form-control-sm">
                        </div></td>
                    </tr>
                    <tr>
                        <td><div class="input-group mb-3">
                            <span class="input-group-text">Passport No.</span>
                            <input id="passportID" name="passportID" type="tel" value="{{passenger.passportID}}" class="form-control form-control-sm">
                        </div></td>
                         <td><div class="input-group mb-3">
                            <span class="input-group-text">Flight No.</span>
                            <input id="flightNum" name="flightNum" type="text" value="{{flight.flightNum}}" readonly class="form-control form-control-sm">                       
                        </div></td>   
                    </tr>
                </table>
                <table id="packageSelectionTable">
                    <tr>
                        <td colspan="2"><h5>Package Selection</h5></td>
                    </tr>
                    <tr>
                        <td><div class="input-group mb-3">
                            <span class="input-group-text">Meal Option:</span>
                            <select class="form-select" aria-label="meal" id="meal" name="meal">
                            <option value="No Meal" selected>No Meal</option>
                            <option value="Standard">Standard</option>
                            <option value="Vegetarian">Vegetarian</option>
                            <option value="Kosher">Kosher</option>
                            </select>
                        </div></td> 
                        <td><div class="input-group mb-3">
                            <span class="input-group-text">Baggage:</span>
                            <select class="form-select" aria-label="baggage" id="baggage" name="baggage">
                            <option value="No Baggage" selected>No Baggage</option>
                            <option value="20 kg">20 kg</option>
                            <option value="24 kg">24 kg</option>
                            <option value="28 kg">28 kg</option>
                            <option value="32 kg">32 kg</option>
                            </select>
                    </tr>
                

                </table>

                    <div class="container text-center mt-4">
            <h3>Seat Selection</h3>

          <div id="planeBox" class="d-inline-block mt-3">

  {{#each seatsByRow}}
    <div class="row justify-content-center mb-2">

      <!-- Left side -->
      {{#each this.left}}
        <input type="radio" 
               class="btn-check" 
               name="seatSelection" 
               id="seat-{{this.seatNumber}}"
               value="{{this.seatNumber}}" 
               autocomplete="off"
               {{#unless this.isVacant}}disabled{{/unless}}
               {{#if this.checked}}checked{{/if}}>
                 
        <label class="btn {{#if this.isVacant}}btn-outline-success{{else}}btn-outline-danger{{/if}}" 
               for="seat-{{this.seatNumber}}" 
               style="width:60px; height:40px;">
          {{this.seatNumber}}
        </label>
      {{/each}}

      <span style="display:inline-block; width:30px;"></span> <!-- aisle -->

      <!-- Right side -->
      {{#each this.right}}
        <input type="radio" 
               class="btn-check" 
               name="seatSelection" 
               id="seat-{{this.seatNumber}}"
               value="{{this.seatNumber}}" 
               autocomplete="off" 
               {{#unless this.isVacant}}disabled{{/unless}}
               {{#if this.checked}}checked{{/if}}>  
        <label class="btn {{#if this.isVacant}}btn-outline-success{{else}}btn-outline-danger{{/if}}" 
               for="seat-{{this.seatNumber}}" 
               style="width:60px; height:40px;">
          {{this.seatNumber}}
        </label>
      {{/each}}

    </div>
  {{/each}}

</div>
                
     <div id="submitButtonReservationDiv">
         <button type="submit" class="btn btn-secondary">Submit</button>
           </div>
        </div>
        </form>
