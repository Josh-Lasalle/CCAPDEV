<h3 class="align-center"> Search Flights </h3>
<hr class="hr-adjustment2">

<div class="customBorder">
<div id="errorMessage"></div>
<form id="searchForm" class="row g-3 needs-validation" action="/client/searchFlight" method="POST" novalidate>


    <div class="col-md-5 position-relative">
      <div class="input-group mb-3">
        <span class="input-group-text">Select an origin</span>
        <select id="origin" name="origin" class="form-select form-select-sm" required>
            <option selected value=""> -- Choose Country -- </option>
            <option value="Manila"> Manila (MNL) </option>
            <option value="Beijing"> Beijing (BJS) </option>
            <option value="Rome"> Rome (ROM) </option>
            <option value="San Francisco"> San Francisco (SFO) </option>
            <option value="seoul"> Seoul (SEL) </option>
          </select>
      </div>   
  </div>

  <div class="col-md-5 position-relative">
    <div class="input-group mb-3">    
           <span class="input-group-text">Select a destination</span>
              <select id="destination" name="destination" class="form-select form-select-sm" required>
                    <option selected value=""> -- Choose Country -- </option>
                    <option value="Manila"> Manila (MNL) </option>
                    <option value="Beijing"> Beijing (BJS) </option>
                    <option value="Rome"> Rome (ROM) </option>
                    <option value="San Francisco"> San Francisco (SFO) </option>
                    <option value="Seoul"> Seoul (SEL) </option>
              </select>
    </div>   
  </div>  
    
      <div class="col-md-3 position relative">
        <div class="input-group mb-3">
          <span class="input-group-text">Select a departure date</span>
          <input type="date" name="departure" id="departureDate" class="form-control" required/> <!--YYYY/MM/DD -->
        </div>
      </div>

      
      <div class="col-md-2 position relative">
        <div class="input-group mb-3">
        <span class="input-group-text">Passenger Count</span>
        <input type="number" min="1" max="9" id="passengerCount" name="passengerCount" class="form-control" required/>
        </div>
      </div>

      <div class="col-12">
        <input type="submit" class="btn btn-secondary" />
      </div>
  </form>
</div>
<div id="flightMessage"></div>


<div id="flightResults" class="mt-4">
  {{#if errorMessage}}
    <div class="alert alert-danger">{{errorMessage}}</div>
  {{/if}}

  {{#if message}}
    <div class="alert alert-info">{{message}}</div>
  {{/if}}

  {{#if flights.length}}
    <h4>Available Flights</h4>
    <hr>
    <div class="list-group">
      {{#each flights}}
        <div class="list-group-item mb-2">
          <h5>{{airline}} {{flightNumber}}</h5>
          <p>
            Origin: {{origin}} <br>
            Destination: {{destination}} <br>
            Departure Date: {{departureDate}} <br>
            Time: {{departureTime}} <br>
            Seats : {{passengerCount}}/{{seatCap}} <br>
            Price: PHP{{price}}
          </p>
          <form action="/bookFlight" method="POST">
            <input type="hidden" name="flightId" value="{{_id}}">
            <input type="hidden" name="passengerCount" value="{{../search.passengerCount}}">
            <button type="submit" class="btn btn-primary">Book</button>
          </form>
        </div>
      {{/each}}
    </div>
  {{/if}}
</div>

