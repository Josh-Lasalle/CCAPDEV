        <div class="card-body">
          <h5>Manila</h5>
          <p class="card-text">Manila is the capital city of the Philippines, a highly urbanized metropolis located on the island of Luzon.</p>
          <a href="/client/book" class="btn btn-secondary">Book Now</a>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card" style="width: 18rem;">
        <img src="/images/beijing.jpg" class="card-img-top" alt="beijing">
          <div class="card-body">
            <h5>Beijing</h5>
            <p class="card-text">Beijing is China's capital and political, cultural, and educational center, with a rich history stretching over three millennia.</p>
            <a href="/client/book" class="btn btn-secondary">Book Now</a>
          </div>
      </div>
    </div>
  

    <div class="col">
      <div class="card" style="width: 18rem;">
        <img src="/images/rome.jpg" class="card-img-top" alt="rome">
          <div class="card-body">
            <h5>Rome</h5>
            <p class="card-text">Rome is the capital of Italy, located on the Tiber River, and known as the "Eternal City" for its immense historical significance.</p>
            <a href="/client/book" class="btn btn-secondary">Book Now</a>
          </div>
      </div>
    </div>
  

    <div class="col">
      <div class="card" style="width: 18rem;">
        <img src="/images/sanfrancisco.jpg" class="card-img-top" alt="sanfrancisco">
          <div class="card-body">
            <h5>San Francisco</h5>
            <p class="card-text">San Francisco is a major cultural, financial, and cultural hub, located on a peninsula between the Pacific Ocean and San Francisco Bay.</p>
            <a href="/client/book" class="btn btn-secondary">Book Now</a>
          </div>
        </div>
    </div>

    <div class="col">
      <div class="card" style="width: 18rem;">
        <img src="/images/seoul.jpg" class="card-img-top" alt="seoul">
          <div class="card-body">
            <h5>Seoul</h5>
            <p class="card-text">Seoul is the capital and largest city of South Korea, a vibrant metropolis known for its blend of modern skyscrapers and ancient history.</p>
            <a href="/client/book" class="btn btn-secondary">Book Now</a>
          </div>
        </div>
    </div>

  </div>
</div>

<footer>
<div class="container my-5">
<p> @BingBong Airlines 2025 </p>
</div>
</footer>
