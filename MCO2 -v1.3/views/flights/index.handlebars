<div class="container-fluid my-5 px-5">
  <div class="d-flex justify-content-between mb-3">

<h1 class="fw-bold mb-0">
<svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="bi bi-airplane-engines-fill" viewBox="0 0 16 16">
  <path d="M8 0c-.787 0-1.292.592-1.572 1.151A4.35 4.35 0 0 0 6 3v3.691l-2 1V7.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.191l-1.17.585A1.5 1.5 0 0 0 0 10.618V12a.5.5 0 0 0 .582.493l1.631-.272.313.937a.5.5 0 0 0 .948 0l.405-1.214 2.21-.369.375 2.253-1.318 1.318A.5.5 0 0 0 5.5 16h5a.5.5 0 0 0 .354-.854l-1.318-1.318.375-2.253 2.21.369.405 1.214a.5.5 0 0 0 .948 0l.313-.937 1.63.272A.5.5 0 0 0 16 12v-1.382a1.5 1.5 0 0 0-.83-1.342L14 8.691V7.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v.191l-2-1V3c0-.568-.14-1.271-.428-1.849C9.292.591 8.787 0 8 0"/>
</svg>
Flight Management</h1>

<a href="/flights/add" class="btn btn-primary btn-lg">+ Add</a>
</div>

<div class="table-responsive">
<table class="table table-hover ">
<thead class="table-light">
  
    <tr>
      <th>FlightNum</th>
      <th>Airline</th>
      <th>Aircraft Type</th>
      <th>Origin</th>
      <th>Destination</th>
      <th>Departure Date</th>
      <th>Departure Time</th>
      <th>Arrival Date</th>
      <th>Arrival Time</th>
      <th>Seat Capacity</th>
      <th>Price</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each flight}}
    <tr>
      <td>{{this.flightNum}}</td>
      <td>{{this.airline}}</td>
      <td>{{this.aircraftType}}</td>
      <td>{{this.origin}}</td>
      <td>{{this.destination}}</td>
      <td>{{this.departureDate}}</td>
      <td>{{this.departureTime}}</td>
      <td>{{this.arrivalDate}}</td>
      <td>{{this.arrivalTime}}</td>
      <td>{{this.seatCap}}</td>
      <td>{{this.price}}</td>
      <td>
        <form action="/flights/delete/{{this._id}}" method="POST">
          <a href="/flights/edit/{{this._id}}" class="btn btn-sm btn-outline-success">Edit</a>
          <button type="submit" class="btn btn-sm btn-outline-danger">DEL</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
</div>
