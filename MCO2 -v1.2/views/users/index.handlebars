<div class="container-fluid my-5 px-5">
  <div class="d-flex align-items-center justify-content-between mb-3">
<h1 class="dispaly-6 fw-bold mb-0">User Management</h1>
<a href="/users/add" class="btn btn-primary btn-lg">+ Add</a>
</div>

<div class="table-responsive">
<table class="table table-hover">
  <thead class="table-light">
    <tr>
      <th>Username</th>
      <th>Role</th>
      <th>Email</th>
      <th>Reference NOs.</th>
      <th>Password</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#each users}}
    <tr>
      <td>{{this.username}}</td>
      <td>{{this.role}}</td>
      <td>{{this.email}}</td>
      <td>{{this.referenceNums}}</td>
      <td>{{this.password}}</td>
      <td>
        <form action="/users/delete/{{this._id}}" method="post">
          <a href="/users/edit/{{this._id}}" class="btn btn-sm btn-outline-success">Edit</a>
          <button type="submit" class="btn btn-sm btn-outline-danger">DEL</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
</div>
